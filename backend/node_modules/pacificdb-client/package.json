{
  "name": "pacificdb-client",
  "version": "0.2.0",
  "description": "Official PacificDB TypeScript/JavaScript client",
  "keywords": ["pacificdb", "database", "nosql", "client", "sdk"],
  "license": "MIT",
  "author": "PacificDB",
  "repository": {
    "type": "git",
    "url": "https://github.com/hitesh-reddy-k/database-engine-linux.git",
    "directory": "packages/pacificdb-client"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --out-dir dist --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  }
}
