{
  "name": "pacificboard-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "PacificBoard API server powered by PacificDB",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.mjs",
    "seed:tasks": "node scripts/seed-demo-tasks.mjs",
    "seed:chat": "node scripts/seed-demo-chat.mjs",
    "reindex:vectors": "node scripts/reindex-vectors.mjs",
    "index:vectors:native": "node scripts/index-vectors-native.mjs",
    "setup:db": "node scripts/setup-db.mjs",
    "benchmark:semantic": "node benchmarks/pacificdb-semantic-search.mjs",
    "benchmark:semantic:10k": "node benchmarks/pacificdb-semantic-search.mjs --vectors 10000",
    "benchmark:semantic:100k": "node benchmarks/pacificdb-semantic-search.mjs --vectors 100000",
    "benchmark:semantic:1m": "node benchmarks/pacificdb-semantic-search.mjs --vectors 1000000"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "pacificdb-client": "^0.2.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^10.0.0"
  }
}
